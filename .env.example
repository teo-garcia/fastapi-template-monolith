# Application (dev default; review DEBUG and API_PREFIX per environment)
APP_NAME=FastAPI Monolith Template
APP_VERSION=1
DEBUG=false
PORT=8000
HTTP_PORT=8080
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT=10

# Database (required change in production; never reuse local credentials)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_monolith
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis (required change in production when Redis is not local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Logging (production normally uses info + json)
LOG_LEVEL=info
LOG_JSON=true

# CORS (required change in staging/production; never use wildcard origins)
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (review per environment)
THROTTLE_LIMIT=100/minute

# Metrics (disable only when another telemetry path owns metrics)
METRICS_ENABLED=true

# Tracing (local observability stack uses http://otel-collector:4318/v1/traces in Docker)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=fastapi-template-monolith
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# pgAdmin (local docker only; not used by production compose)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
